rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers de Role e Segurança Aprimorada ───────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isDesativado() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/empresaUsuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/empresaUsuarios/$(request.auth.uid)).data.role == 'desativado') ||
        exists(/databases/$(database)/documents/usuariosDesativados/$(request.auth.uid))
      );
    }

    function isEmpresaOwner(empresaId) {
      // Empresa ativa: possui vínculo com a empresa e role == 'empresa' (não desativada)
      return isAuthenticated() &&
        !isDesativado() &&
        exists(/databases/$(database)/documents/empresaUsuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/empresaUsuarios/$(request.auth.uid)).data.empresaId == empresaId &&
        get(/databases/$(database)/documents/empresaUsuarios/$(request.auth.uid)).data.role == 'empresa';
    }

    function isAdmin() {
      // Admin Seguro: Autenticado, não desativado, e:
      // 1. Presente explicitamente na coleção de admins
      // 2. OU claim admin verificada no token de autenticação
      return isAuthenticated() &&
        !isDesativado() &&
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
          request.auth.token.role == 'admin'
        );
    }

    // ─── Coleção de Administradores Explícitos ─────────────────────────────
    match /admins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Permite o primeiro registro inicial do administrador autenticado ou gestão por admin
      allow create: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ─── Coleção de Bloqueio (Usuários Desativados) ─────────────────────────
    match /usuariosDesativados/{uid} {
      allow read, write: if isAdmin();
    }

    // ─── empresaUsuarios — vínculo uid ↔ empresa ───────────────────────────
    match /empresaUsuarios/{uid} {
      // Leitura: o próprio usuário lê seu vínculo OU admin pode listar todos
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      // Escrita: apenas admins
      allow write: if isAdmin();
    }

    // ─── Posts Universais (Gestão Central de Publicações) ───────────────────
    match /postsUniversais/{postId} {
      allow read, write: if isAdmin();
    }

    // ─── Empresas ─────────────────────────────────────────────────────────
    match /empresas/{empresaId} {
      // Leitura individual de documento (get) aberta para páginas públicas
      allow get: if true;
      // Listagem geral (list): restrita a admins OU busca filtrada com limite de até 5 resultados
      allow list: if isAdmin() || (request.query.limit <= 5);
      // Escrita: admin ou a própria empresa dona
      allow write: if isAdmin() || isEmpresaOwner(empresaId);

      // ─── Notícias (subcoleção) ──────────────────────────────────────────
      match /noticias/{noticiaId} {
        allow read: if true;
        allow write: if isAdmin() || isEmpresaOwner(empresaId);
      }

      // ─── Subcoleções de demandas (proteção de integridade e dados sensíveis) ───
      // Leitura: admin ou a própria empresa
      // Criação: pública, mas validando status e limite de payload contra DoS
      // Atualização/Exclusão: restrito a admin ou empresa dona

      match /sugestoes/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow create: if request.resource.data.status in ['nova', 'pendente']
                      && (!('mensagem' in request.resource.data) || request.resource.data.mensagem.size() <= 10000);
        allow update, delete: if isAdmin() || isEmpresaOwner(empresaId);
      }

      match /denuncias/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow create: if request.resource.data.status in ['nova', 'pendente']
                      && (!('descricao' in request.resource.data) || request.resource.data.descricao.size() <= 15000);
        allow update, delete: if isAdmin() || isEmpresaOwner(empresaId);
      }

      match /atestados/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow create: if request.resource.data.status in ['nova', 'pendente']
                      && (!('nomeFuncionario' in request.resource.data) || request.resource.data.nomeFuncionario.size() <= 150);
        allow update, delete: if isAdmin() || isEmpresaOwner(empresaId);
      }

      match /auxilios/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow create: if request.resource.data.status in ['nova', 'pendente'];
        allow update, delete: if isAdmin() || isEmpresaOwner(empresaId);
      }

      match /apoioSaude/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow create: if request.resource.data.status in ['nova', 'pendente'];
        allow update, delete: if isAdmin() || isEmpresaOwner(empresaId);
      }

      match /segurancaTrabalho/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow create: if request.resource.data.status in ['nova', 'pendente'];
        allow update, delete: if isAdmin() || isEmpresaOwner(empresaId);
      }

      match /documentos/{document=**} {
        allow read: if isAdmin() || isEmpresaOwner(empresaId);
        allow write: if isAdmin() || isEmpresaOwner(empresaId);
      }
    }
  }
}
